# expo-router's web devtools pull in @expo/ui/vaul -> radix-ui packages that
# want a newer react-dom peer than the react version this RN app is pinned
# to. react-dom itself is never used at runtime here (Android/iOS only) —
# it's purely a transitive peer of web-only dev tooling — so this is safe to
# relax rather than something to actually resolve by bumping react.
# Without this, EAS Build's `npm ci` fails at the Install dependencies step.
legacy-peer-deps=true
