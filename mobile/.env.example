# Copy this file to .env and fill in your actual Supabase project values.
# .env is gitignored — never commit real credentials.
#
# These EXPO_PUBLIC_* values ship inside the client bundle. That's expected —
# they're protected by Postgres Row Level Security, not secrecy. The
# SUPABASE_SERVICE_ROLE_KEY must NEVER appear here or anywhere in this app;
# it belongs only in Supabase Edge Function / server-side config.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
