# Supabase CLI local link/session cache — machine-specific, never committed
supabase/.temp/

# Subagent git-worktree scratch space — ephemeral, never committed
.claude/worktrees/

# Firebase Admin SDK service account keys — grant full admin access to the
# Firebase project, never committed. Used once to upload to EAS via
# `eas credentials`, then safe to delete locally.
*firebase-adminsdk*.json

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Marketing/design one-off outputs — not part of the app, never needed in an
# EAS build upload. marketing/brag-video/ alone was ~161MB and, with no
# .easignore present, EAS archives from the git root and follows .gitignore —
# so this was silently riding along on every `eas build`, ballooning the
# upload from ~94MB to 135MB+ and causing repeated ECONNRESET failures on a
# transfer that large.
/marketing/brag-video/
/marketing/app-store-screenshots/public/screenshots/uploaded/
/assets/app screens/
/assets/thrill-mill-club-android-store bundle/
/assets/thrill-mill-club-android-store bundle.zip
/.agents/

# Tournament Memory Engine experiments: raw club footage, intermediates and
# renders are large and private — keep scene plans/notes, not media.
tournament-memory/**/input/
tournament-memory/**/work/
tournament-memory/**/*.mp4
tournament-memory/**/*.mov
tournament-memory/**/*.wav

# Raw AI-generated seasonal art (large PNGs straight from ChatGPT/Flow) — only
# the cut-out, optimised WebPs under mobile/assets/seasons/ ship in the app.
/assets/seasons-raw/
# Tournament-memory libraries/derivatives: licensed media + fonts are re-downloadable, keep them out of git/EAS
tournament-memory/**/*.mp3
tournament-memory/**/*.ttf
tournament-memory/**/*.png
tournament-memory/**/*.jpg
tournament-memory/**/snapshots/
tournament-memory/**/out/
tournament-memory/**/_analysis/
tournament-memory/**/assets/gsap.min.js
